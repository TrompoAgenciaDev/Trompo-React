# ================================
# React SPA routing
# ================================
RewriteEngine On
RewriteBase /

# Permitir acceso a archivos estáticos (assets, imágenes, videos, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]

# Permitir acceso a directorios
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [L]

# Evita bucles al servir index.html
RewriteRule ^index\.html$ - [L]

# Si el archivo o directorio no existe, redirige todo a index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ================================
# MIME types correctos para video y media
# ================================
AddType video/mp4 .mp4
AddType video/webm .webm
AddType video/ogg .ogv
AddType video/quicktime .mov
AddType audio/mpeg .mp3
AddType audio/ogg .ogg
AddType font/woff2 .woff2
AddType font/woff .woff

# ================================
# Control de caché - Desactivar cuando sea necesario
# ================================
<IfModule mod_setenvif.c>
  # Detectar parámetro nocache en query string
  SetEnvIf QueryString "nocache=" NO_CACHE=1
</IfModule>

# ================================
# Headers necesarios para Safari y streaming
# ================================
<IfModule mod_headers.c>
  # Habilita la reproducción por rango de bytes (streaming parcial)
  Header always set Accept-Ranges "bytes"

  # Evita errores CORS en Safari al cargar videos o fuentes
  Header always set Access-Control-Allow-Origin "*"

  # Desactivar caché para páginas de limpieza de caché
  <FilesMatch "(clear-cache)">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Desactivar caché cuando hay parámetro ?nocache en la URL
  <IfModule mod_setenvif.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0" env=NO_CACHE
    Header always set Pragma "no-cache" env=NO_CACHE
    Header always set Expires "0" env=NO_CACHE
  </IfModule>

  # ================================
  # Caché largo (1 año) para recursos estáticos inmutables
  # ================================
  
  # Imágenes estáticas (incluyendo WebP)
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Videos
  <FilesMatch "\.(mp4|webm|ogv|mov)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Fuentes (todas las variantes)
  <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Archivos JS y CSS con hash (generados por Vite) - inmutables
  # Patrón: NombreComponente.hash.js o vendor-nombre.hash.js
  # El hash tiene 8 caracteres alfanuméricos seguidos de .js o .css
  # También incluye archivos .br (Brotli comprimidos)
  <FilesMatch "\.([A-Za-z0-9]{8}\.)(js|css|br)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Fallback: Archivos JS/CSS que tengan dos puntos (nombre.hash.extensión)
  # Esto captura todos los archivos con hash de Vite
  <FilesMatch "\.[A-Za-z0-9]+\.[A-Za-z0-9]+\.(js|css|br)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Archivos JSON estáticos (portfolio, posts, etc.)
  <FilesMatch "\.(json)$">
    Header always set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>
  
  # Asegura que los vídeos se entreguen con el tipo MIME correcto
  <FilesMatch "\.(mp4|webm|ogv|mov)$">
    Header always set Content-Type "video/mp4"
  </FilesMatch>
</IfModule>

# ================================
# Transferencia comprimida opcional
# ================================
<IfModule mod_mime.c>
  AddEncoding gzip .gz
</IfModule>

# ================================
# Seguridad básica (opcional, no interfiere con React)
# ================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>